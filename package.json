{
  "name": "tunnelsats-startos",
  "version": "0.4.0",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "build": "node scripts/sync-version.js && rm -rf ./javascript && ncc build startos/index.ts -o ./javascript",
    "prettier": "prettier --write startos",
    "check": "tsc --noEmit",
    "test:bats": "npx -y bats tests/*.bats",
    "test:all": "tsx --test tests/*.test.ts && python3 -m unittest discover -s tests -p 'test_*.py' && npx -y bats tests/*.bats"
  },
  "dependencies": {
    "@start9labs/start-sdk": "2.0.9",
    "cln-startos": "github:Start9Labs/cln-startos#master",
    "lnd-startos": "github:Start9Labs/lnd-startos#master"
  },
  "overrides": {
    "@start9labs/start-sdk": "2.0.9",
    "js-yaml": "^4.3.2",
    "minimatch@3": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.9"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vercel/ncc": "^0.45.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "yaml": "^2.9.1"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  }
}
